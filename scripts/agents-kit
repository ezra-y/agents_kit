    rows = plugins.list_plugins(context.repo)
    return {"plugins": rows, "count": len(rows)}


def command_plugin_show(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    return plugins.show_plugin(context.repo, args.name)


def command_plugin_open(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    spec = context.repo.require_plugin(args.name)
    if not args.dry_run:
        result = subprocess.run(
            ["open", str(spec.root)],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode:
            raise CommandError(result.stderr.strip() or "Finder 打开失败")
    return {"plugin": spec.package_id, "path": str(spec.root), "dry_run": args.dry_run}


def command_plugin_enable(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    spec = context.repo.require_plugin(args.name)
    target_spec = spec.targets.get(args.target)
    if target_spec is None or target_spec.support not in {"full", "partial"}:
        raise CommandError(
            f"{spec.package_id} 在 {args.target} 上尚不可安装："
            f"{target_spec.support if target_spec else 'missing'}"
        )
    distribution = args.distribution or (
        "skills-dir" if args.target == "claude" else "marketplace"
    )
    desired = context.repo.read_desired_installations()
    item = {
        "ref": AssetRef.plugin(spec.package_id).canonical,
        "distribution": distribution,
    }
    current = desired["targets"][args.target].setdefault("plugins", [])
    existing = next(
        (
            value
            for value in current
            if isinstance(value, dict) and value.get("ref") == item["ref"]
        ),
        None,
    )
    changed = existing != item
    if existing is not None:
        current.remove(existing)
    current.append(item)
    try:
        installation.require_valid_desired_installations(context.repo, desired)
    except InstallationError as exc:
        raise CommandError(str(exc)) from exc
    if args.dry_run:
        return {
            "dry_run": True,
            "plugin": item["ref"],
            "target": args.target,
            "distribution": distribution,
            "changed": changed,
        }
    with context.repo.write_lock():
        context.repo.write_desired_installations(desired)
        marketplace.build(context.repo)
    change = ChangeSet(
        changed={"desired_installations"} if changed else set(),
        effects={Effect.DOCS_BUILD, Effect.CHECK, Effect.GLOBAL_APPLY},
        details={
            "plugin": item["ref"],
            "target": args.target,
            "distribution": distribution,
        },
    )
    return context.finish(change)


def command_plugin_disable(
    args: argparse.Namespace, context: Context
) -> dict[str, Any]:
    spec = context.repo.require_plugin(args.name)
    desired = context.repo.read_desired_installations()
    ref = AssetRef.plugin(spec.package_id).canonical
    current = desired["targets"][args.target].setdefault("plugins", [])
    updated = [
        item for item in current if not isinstance(item, dict) or item.get("ref") != ref
    ]
    changed = updated != current
    desired["targets"][args.target]["plugins"] = updated
    try:
        installation.require_valid_desired_installations(context.repo, desired)
    except InstallationError as exc:
        raise CommandError(str(exc)) from exc
    if args.dry_run:
        return {
            "dry_run": True,
            "plugin": ref,
            "target": args.target,
            "changed": changed,
        }
    with context.repo.write_lock():
        context.repo.write_desired_installations(desired)
    change = ChangeSet(
        changed={"desired_installations"} if changed else set(),
        effects={Effect.DOCS_BUILD, Effect.CHECK, Effect.GLOBAL_APPLY},
        details={"plugin": ref, "target": args.target},
    )
    return context.finish(change)


def command_plugin_update(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    names = sorted(context.repo.read_sources()["plugins"]) if args.all else [args.name]
    if not args.dry_run:
        _confirm(args, f"处理 {len(names)} 个 Plugin 的上游变化？")
    results: list[dict[str, Any]] = []
    failures: list[dict[str, str]] = []
    combined = ChangeSet()
    with SourceSession(context.repo.network_timeout) as session:
        for name in names:
            record = context.repo.read_sources()["plugins"].get(name)
            if record is None:
                failures.append({"plugin": name, "error": "没有来源登记"})
                continue
            if record.get("policy") == "pinned":
                results.append({"plugin": name, "status": "pinned", "applied": False})
                continue
            try:
                spec = SourceSpec(
                    provider=str(record["provider"]),
                    locator=dict(record["locator"]),
                )
                root, revision, resolved_spec = session.directory(spec)
                snapshot = plugins.inspect_plugin_directory(
                    root,
                    revision=revision,
                    source_spec=resolved_spec,
                )
                comparison = plugins.classify_plugin_update(
                    context.repo, name, snapshot
                )
                should_apply = (
                    comparison["decision"] == "auto_apply"
                    if args.auto_docs
                    else comparison["merge_state"] == "upstream_only"
                    and comparison["decision"] != "blocked"
                )
                results.append(
                    {
                        "plugin": name,
                        **comparison,
                        "revision": revision,
                        "applied": should_apply and not args.dry_run,
                    }
                )
                if should_apply and not args.dry_run:
                    with context.repo.write_lock():
                        combined.merge(
                            plugins.update_plugin_from_snapshot(
                                context.repo, name, snapshot
                            )
                        )
            except (OSError, RuntimeError, ValueError) as exc:
                failures.append({"plugin": name, "error": str(exc)})
    if combined.changed:
        with context.repo.write_lock():
            marketplace.build(context.repo)
        finished = context.finish(combined, apply_clients=not args.repo_only)
    else:
        finished = {"changed": [], "details": {}, "warnings": [], "effects": {}}
    finished["results"] = results
    finished["failures"] = failures
    finished["dry_run"] = args.dry_run
    return finished


def command_plugin_detach(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    spec = context.repo.require_plugin(args.name)
    if args.dry_run:
        return {
            "dry_run": True,
            "plugin": spec.package_id,
            "tracked": context.repo.read_sources()["plugins"].get(spec.package_id)
            is not None,
        }
    with context.repo.write_lock():
        change = plugins.detach_plugin(context.repo, spec.package_id)
    return context.finish(change)


def command_plugin_remove(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    spec = context.repo.require_plugin(args.name)
    if args.dry_run:
        return {
            "dry_run": True,
            "plugin": spec.package_id,
            "path": str(spec.root),
        }
    _confirm(args, f"删除完整 Plugin {spec.package_id}？")
    with context.repo.write_lock():
        change = plugins.remove_plugin(context.repo, spec.package_id)
        change.details["marketplace"] = marketplace.build(context.repo)
    return context.finish(change)


def command_marketplace_build(
    args: argparse.Namespace, context: Context
) -> dict[str, Any]:
    with context.repo.write_lock():
        return marketplace.build(context.repo)


def command_marketplace_check(
    args: argparse.Namespace, context: Context
) -> dict[str, Any]:
    stale = marketplace.check(context.repo)
    if stale:
        raise CommandError("Marketplace 索引已过期：" + ", ".join(stale))
    return {"ok": True, "stale": []}


def command_marketplace_status(
    args: argparse.Namespace, context: Context
) -> dict[str, Any]:
    return marketplace.status(context.repo)


def command_mcp_import(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    if args.distribution != "remote" and (not args.package or not args.version):
        raise CommandError("非 remote 分发必须提供 --package 和 --version")
    if args.distribution == "remote" and (args.package or args.version):
        raise CommandError("remote 分发不接受 --package 或 --version")
    environment: dict[str, Any] = {
        name: {
            "required": True,
            "source": {"type": "environment", "name": name},
        }
        for name in args.secret_env
    }
    for raw in args.secret_command:
        if "=" not in raw:
            raise CommandError("--secret-command 必须使用 NAME=COMMAND")
        name, command = raw.split("=", 1)
        argv = shlex.split(command)
        if not name or not argv:
            raise CommandError("--secret-command 必须使用 NAME=COMMAND")
        if name in environment:
            raise CommandError(f"重复的凭据来源：{name}")
        environment[name] = {
            "required": True,
            "source": {"type": "command", "argv": argv},
        }
    configured_targets = [
        target["id"] for target in context.repo.config["mcp_install_targets"]["global"]
    ]
    targets = list(dict.fromkeys(args.target or configured_targets))
    record = {
        "description": args.description,
        "tags": list(dict.fromkeys(args.tag)),
        "recommendation": args.recommendation,
        "source": {
            "url": args.source,
            "policy": context.repo.config["defaults"]["source_policy"],
        },
        "distribution": {
            key: value
            for key, value in {
                "type": args.distribution,
                "package": args.package,
                "version": args.version,
            }.items()
            if value is not None
        },
        "runtime": {"command": args.command, "args": args.arg},
        "environment": environment,
        "targets": targets,
        "enabled": args.scope == "global",
    }
    mcps.validate_server(
        args.name,
        record,
        configured_targets=set(configured_targets),
    )
    previous = context.repo.read_mcps()["servers"].get(args.name)
    existing = previous is not None
    if args.dry_run:
        return {
            "dry_run": True,
            "mcp": args.name,
            "scope": args.scope,
            "targets": targets,
            "existing": existing,
            "record": record,
        }
    if existing and not args.replace:
        raise CommandError(f"MCP 已存在：{args.name}")
    if existing and args.replace:
        _confirm(args, f"替换 MCP {args.name} 的中央记录和受管配置？")
    if record["enabled"]:
        mcps.ensure_distribution(record)
    with context.repo.write_lock():
        change = mcps.import_server(
            context.repo,
            args.name,
            record,
            replace=args.replace,
        )
    stale_targets = []
    if previous is not None:
        stale_targets = [
            target
            for target in previous["targets"]
            if not record["enabled"] or target not in record["targets"]
        ]
    client_actions: list[dict[str, Any]] = []
    if stale_targets:
        removed = mcps.remove_from_targets(
            context.repo,
            args.name,
            targets=stale_targets,
        )
        client_actions.extend(removed["actions"])
    if record["enabled"]:
        applied = mcps.apply(
            context.repo,
            [args.name],
            replace=args.replace,
        )
        client_actions.extend(applied["actions"])
    if client_actions:
        change.details["client_apply"] = {
            "dry_run": False,
            "actions": client_actions,
            "conflicts": [],
        }
    return context.finish(change)


def command_mcp_list(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    rows = mcps.list_servers(context.repo, enabled_only=args.enabled)
    return {"mcps": rows, "count": len(rows)}


def command_mcp_show(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    return mcps.show_server(context.repo, args.name)


def command_mcp_enable(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    mcps.show_server(context.repo, args.name)
    if args.dry_run:
        return {"dry_run": True, "mcp": args.name, "enabled": True}
    with context.repo.write_lock():
        change = mcps.set_enabled(context.repo, args.name, True)
    change.details["client_apply"] = mcps.apply(context.repo, [args.name])
    return context.finish(change)


def command_mcp_disable(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    mcps.show_server(context.repo, args.name)
    if args.dry_run:
        return {"dry_run": True, "mcp": args.name, "enabled": False}
    with context.repo.write_lock():
        change = mcps.set_enabled(context.repo, args.name, False)
    change.details["client_apply"] = mcps.apply(context.repo, [args.name])
    return context.finish(change)


def command_mcp_apply(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    names = None if args.all else [args.name]
    if args.replace:
        _confirm(args, "替换客户端中不受 agents-kit 管理的同名 MCP？")
    return mcps.apply(
        context.repo,
        names,
        dry_run=args.dry_run,
        replace=args.replace,
    )


def command_mcp_update(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    names = None if args.all else [args.name]
    if not args.dry_run:
        _confirm(args, "应用当前可用的 MCP 上游版本？")
    result = mcps.update_versions(
        context.repo,
        names,
        dry_run=args.dry_run,
    )
    if result["changed"]:
        change = ChangeSet(
            changed=set(result["changed"]),
            effects={Effect.DOCS_BUILD, Effect.CHECK},
            details={"mcp_updates": result["results"]},
        )
        return context.finish(change)
    return result


def command_mcp_remove(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    record = mcps.show_server(context.repo, args.name)
    if args.dry_run:
        return {
            "dry_run": True,
            "mcp": args.name,
            "targets": record["targets"],
        }
    _confirm(args, f"删除 MCP {args.name} 及受管客户端配置？")
    client_result = mcps.remove_from_targets(context.repo, args.name)
    with context.repo.write_lock():
        change = mcps.remove_server(context.repo, args.name)
    change.details["client_apply"] = client_result
    return context.finish(change)


def command_mcp_run(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    mcps.run_server(context.repo, args.name)
    raise AssertionError("os.execvpe 返回了")


def command_global_enable(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    entry = context.repo.require_skill(args.name)
    if args.dry_run:
        return {
            "dry_run": True,
            "skill": entry.qualified_id,
            "active": entry.name in context.repo.read_active(),
            "target_active": True,
            "target": args.target,
        }
    with context.repo.write_lock():
        change = installation.enable_global(context.repo, args.name, target=args.target)
    return context.finish(change)


def command_global_disable(
    args: argparse.Namespace, context: Context
) -> dict[str, Any]:
    entry = context.repo.require_skill(args.name)
    if args.dry_run:
        return {
            "dry_run": True,
            "skill": entry.qualified_id,
            "active": entry.name in context.repo.read_active(),
            "target_active": False,
            "target": args.target,
        }
    with context.repo.write_lock():
        change = installation.disable_global(
            context.repo, args.name, target=args.target
        )
    return context.finish(change)


def command_global_apply(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    result = installation.apply_global(
        context.repo,
        dry_run=args.dry_run,
        target=args.target,
    ).details
    if not args.dry_run:
        result["runtime"] = runtime.plugin_report(
            context.repo, target_filter=args.target
        )
        if not result["runtime"]["ok"]:
            raise CommandError("安装操作已完成，但宿主加载未通过", result)
    return result


def command_project_install(
    args: argparse.Namespace, context: Context
) -> dict[str, Any]:
    if args.replace:
        _confirm(args, "覆盖项目中的同名技能目录？")
    return installation.install_project(
        context.repo,
        args.target,
        project=args.project,
        replace=args.replace,
        dry_run=args.dry_run,
    ).details


def command_docs_build(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    with context.repo.write_lock():
        return docs.build(context.repo, command_help=context.command_help)


def command_docs_check(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    stale = docs.check(context.repo, command_help=context.command_help)
    if stale:
        raise CommandError("生成文档已过期：" + ", ".join(stale))
    return {"stale": [], "ok": True}


def command_ui(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    with context.repo.write_lock():
        built = docs.build(context.repo, command_help=context.command_help)
    return ui.serve(
        context.repo,
        Path(str(built["html"])),
        port=args.port,
        open_browser=not args.no_open,
    )


def command_check(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    report = checks.run(
        context.repo,
        command_help=context.command_help,
        repo_only=args.repo_only,
        verify_runtime=args.runtime,
    )
    result = {
        "ok": report.ok,
        "problems": report.problems,
        "warnings": report.warnings,
        "sections": report.sections,
    }
    if not report.ok:
        raise CommandError(
            f"体检发现 {len(report.problems)} 个问题",
            result,
        )
    return result


class Context:
    def __init__(self, repo: Repository, parser: argparse.ArgumentParser):
        self.repo = repo
        self.parser = parser
        self.command_help = full_help(parser)

    def finish(
        self, change: ChangeSet, *, apply_clients: bool = True
    ) -> dict[str, Any]:
        effects: dict[str, Any] = {}
        if Effect.DOCS_BUILD in change.effects:
            with self.repo.write_lock():
                effects[Effect.DOCS_BUILD.value] = docs.build(
                    self.repo, command_help=self.command_help
                )
        if Effect.CHECK in change.effects:
            report = checks.run(
                self.repo,
                command_help=self.command_help,
                repo_only=True,
            )
            effects[Effect.CHECK.value] = {
                "ok": report.ok,
                "problems": report.problems,
            }
            if not report.ok:
                raise CommandError(
                    f"修改已写入，但收尾体检发现 {len(report.problems)} 个问题",
                    {
                        "changed": sorted(change.changed),
                        "details": change.details,
                        "effects": effects,
                    },
                )
        if Effect.GLOBAL_APPLY in change.effects and apply_clients:
            effects[Effect.GLOBAL_APPLY.value] = installation.apply_global(
                self.repo
            ).details
            if "plugins" in change.changed or "plugin" in change.details:
                native = runtime.plugin_report(
                    self.repo, target_filter=change.details.get("target")
                )
                effects["runtime"] = native
                if not native["ok"]:
                    raise CommandError(
                        "配置已更新，但宿主加载未通过",
                        {
                            "changed": sorted(change.changed),
                            "details": change.details,
                            "effects": effects,
                        },
                    )
        return {
            "changed": sorted(change.changed),
            "details": change.details,
            "warnings": change.warnings,
            "effects": effects,
        }


def full_help(parser: argparse.ArgumentParser) -> str:
    def stable_help(current: argparse.ArgumentParser) -> str:
        formatter = current.formatter_class
        try:
            current.formatter_class = lambda prog: argparse.HelpFormatter(
                prog, width=80
            )
            text = current.format_help().rstrip()
        finally:
            current.formatter_class = formatter
        usage, separator, body = text.partition("\n\n")
        # argparse's usage wrapping changed between Python 3.12 and 3.13.
        # Store one canonical usage line; the remaining text has a fixed width.
        return " ".join(usage.split()) + separator + body

    chunks: list[str] = [stable_help(parser)]

    def walk(current: argparse.ArgumentParser, prefix: list[str]) -> None:
        for action in current._actions:
            if not isinstance(action, argparse._SubParsersAction):
                continue
            for name, child in action.choices.items():
                command = [*prefix, name]
                chunks.append(f"$ {' '.join(command)} --help\n{stable_help(child)}")
                walk(child, command)

    walk(parser, ["agents-kit"])
    return "\n\n".join(chunks) + "\n"


def _source_spec(session: SourceSession, args: argparse.Namespace):
    options = {
        key: value
        for key, value in {
            "ref": getattr(args, "ref", None),
            "path": getattr(args, "source_path", None),
        }.items()
        if value
    }
    return session.spec(
        args.source,
        provider_id=getattr(args, "provider", None),
        options=options,
    )


def _source_names(repo: Repository, args: argparse.Namespace) -> list[str]:
    if args.all:
        return [
            *sorted(repo.read_sources()["skills"]),
            *[
                AssetRef.plugin(plugin_id).canonical
                for plugin_id in sorted(repo.read_sources()["plugins"])
            ],
        ]
    if args.name.startswith("plugin:"):
        repo.require_plugin(args.name)
        return [args.name]
    entry = repo.require_skill(args.name)
    if entry.owner_kind == "plugin":
        return [AssetRef.plugin(entry.owner_id or "").canonical]
    return [entry.qualified_id]


def _source_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--provider")
    parser.add_argument("--ref")
    parser.add_argument("--source-path", dest="source_path")


def _name_or_all(parser: argparse.ArgumentParser) -> None:
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("name", nargs="?")
    group.add_argument("--all", action="store_true")


def _json_flag(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--json", action="store_true")


def _confirm(args: argparse.Namespace, message: str) -> None:
    if getattr(args, "dry_run", False):
        return
    if getattr(args, "yes", False):
        return
    if not sys.stdin.isatty():
        raise CommandError(f"{message} 非交互环境必须提供 --yes")
    answer = input(f"{message} [y/N] ").strip().lower()
    if answer != "y":
        raise CommandError("已取消")


def _emit(result: dict[str, Any], *, as_json: bool) -> None:
    if as_json:
        print(json.dumps(result, ensure_ascii=False, indent=2, default=str))
        return
    if "skills" in result and isinstance(result["skills"], list):
        for row in result["skills"]:
            marker = "*" if row.get("active") else " "
            tracked = "↑" if row.get("tracked") else " "
            print(f"{marker}{tracked} {row['category']:<8} {row['name']}")
        print(f"\n共 {result.get('count', len(result['skills']))} 个")
        return
    if "mcps" in result and isinstance(result["mcps"], list):
        for row in result["mcps"]:
            marker = "*" if row.get("enabled") else " "
            package = row.get("package") or row["distribution"]
            version = f"@{row['version']}" if row.get("version") else ""
            print(f"{marker} {row['name']:<20} {package}{version}")
        print(f"\n共 {result.get('count', len(result['mcps']))} 个")
        return
    if "plugins" in result and isinstance(result["plugins"], list):
        for row in result["plugins"]:
            targets = ",".join(
                f"{target}:{value['support']}"
                for target, value in row.get("targets", {}).items()
            )
            print(f"{row['id']:<28} {targets}")
        print(f"\n共 {result.get('count', len(result['plugins']))} 个")
        return
    if result.get("ok") is True and "sections" in result:
        summary = result["sections"].get("summary", {})
        print(
            "全部检查通过："
            f"{summary.get('skills', 0)} 个技能，"
            f"{summary.get('active', 0)} 个常驻，"
            f"{summary.get('sources', 0)} 条技能来源，"
            f"{summary.get('enabled_mcps', 0)} 个 MCP 已启用"
        )
        return
    print(json.dumps(result, ensure_ascii=False, indent=2, default=str))


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    as_json = bool(getattr(args, "json", False))
    try:
        override = os.environ.get("AGENTS_KIT_HOME")
        repo = (
            Repository(Path(override))
            if override
            else Repository.discover(SCRIPT_DIR.parent)
        )
        context = Context(repo, parser)
        result = args.handler(args, context)
        if not getattr(args, "streaming", False):
            _emit(result, as_json=as_json)
        return 0
    except CommandError as exc:
        payload = getattr(exc, "payload", None) or {"ok": False, "error": str(exc)}
    except (
        RepositoryError,
        SourceError,
        SkillError,
        ScoutError,
        McpError,
        InstallationError,
        TaxonomyError,
        UiError,
        PluginError,
        MarketplaceError,
        OSError,
        ValueError,
    ) as exc:
        payload = {"ok": False, "error": str(exc)}
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, default=str))
    else:
        print(f"错误：{payload.get('error', payload)}", file=sys.stderr)
        if payload.get("problems"):
            for problem in payload["problems"]:
                print(f"  - {problem}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
