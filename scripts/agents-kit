    return skills.show_skill(context.repo, args.name)


def command_skill_open(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    return ui.open_skill(context.repo, args.name, dry_run=args.dry_run)


def command_skill_metadata(
    args: argparse.Namespace, context: Context
) -> dict[str, Any]:
    if (
        args.description is None
        and args.trigger is None
        and args.recommendation is None
        and args.dependency is None
        and not args.clear_dependencies
        and args.tag is None
        and not args.clear_tags
    ):
        raise CommandError("至少提供一个 metadata 字段")
    dependencies = [] if args.clear_dependencies else args.dependency
    tags = None
    if args.clear_tags:
        tags = args.tag or []
    elif args.tag:
        current = context.repo.metadata_record(args.name) or {}
        tags = list(dict.fromkeys([*current.get("tags", []), *args.tag]))
    if args.dry_run:
        context.repo.require_skill(args.name)
        return {
            "dry_run": True,
            "skill": args.name,
            "updates": {
                key: value
                for key, value in {
                    "description": args.description,
                    "trigger": args.trigger,
                    "recommendation": args.recommendation,
                    "dependencies": dependencies,
                    "tags": tags,
                }.items()
                if value is not None
            },
        }
    with context.repo.write_lock():
        change = skills.set_metadata(
            context.repo,
            args.name,
            description=args.description,
            trigger=args.trigger,
            recommendation=args.recommendation,
            dependencies=dependencies,
            tags=tags,
        )
    return context.finish(change)


def command_skill_rename(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    context.repo.require_skill(args.old_name)
    if args.dry_run:
        return {
            "dry_run": True,
            "old_name": args.old_name,
            "new_name": args.new_name,
        }
    with context.repo.write_lock():
        change = skills.rename_skill(context.repo, args.old_name, args.new_name)
    return context.finish(change)


def command_skill_move(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    entry = context.repo.require_skill(args.name)
    if args.dry_run:
        return {
            "dry_run": True,
            "skill": args.name,
            "from": entry.category,
            "to": args.category,
        }
    with context.repo.write_lock():
        change = skills.move_skill(context.repo, args.name, args.category)
    return context.finish(change)


def command_skill_remove(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    entry = context.repo.require_skill(args.name)
    if args.dry_run:
        return {
            "dry_run": True,
            "skill": args.name,
            "path": str(entry.path),
            "active": args.name in context.repo.read_active(),
            "tracked": context.repo.source_record(args.name) is not None,
        }
    _confirm(args, f"彻底删除 {args.name} 及其登记？")
    with context.repo.write_lock():
        change = skills.remove_skill(context.repo, args.name)
    return context.finish(change)


def command_plugin_inspect(
    args: argparse.Namespace, context: Context
) -> dict[str, Any]:
    with SourceSession(context.repo.network_timeout) as session:
        spec = _source_spec(session, args)
        root, revision, resolved_spec = session.directory(
            spec, candidate_path=args.candidate
        )
        snapshot = plugins.inspect_plugin_directory(
            root,
            revision=revision,
            source_spec=resolved_spec,
        )
        embedded_ids = set(plugins._embedded_skill_ids(root))
        existing = {
            entry.name: entry.qualified_id
            for entry in context.repo.skill_registry().values()
            if entry.owner_kind == "standalone" and entry.name in embedded_ids
        }
        inventory = snapshot.component_inventory
        return {
            "package": "plugin",
            "plugin": snapshot.package_id,
            "provider": resolved_spec.provider,
            "locator": resolved_spec.locator,
            "revision": revision,
            "upstream_targets": sorted(snapshot.upstream_targets),
            "components": {
                name: [path.as_posix() for path in paths]
                for name, paths in inventory.known_components.items()
            },
            "unknown_paths": [path.as_posix() for path in inventory.unknown_paths],
            "executable_paths": [
                path.as_posix() for path in inventory.executable_paths
            ],
            "binary_paths": [path.as_posix() for path in inventory.binary_paths],
            "standalone_matches": existing,
        }


def command_plugin_import(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    targets = tuple(dict.fromkeys(args.targets or ["claude", "codex"]))
    if args.replace:
        _confirm(args, "替换已有完整 Plugin？")
    with SourceSession(context.repo.network_timeout) as session:
        spec = _source_spec(session, args)
        root, revision, resolved_spec = session.directory(
            spec, candidate_path=args.candidate
        )
        snapshot = plugins.inspect_plugin_directory(
            root,
            revision=revision,
            source_spec=resolved_spec,
        )
        if args.dry_run:
            return {
                "dry_run": True,
                "plugin": snapshot.package_id,
                "targets": list(targets),
                "upstream_targets": sorted(snapshot.upstream_targets),
                "embedded_skills": sorted(
                    snapshot.component_inventory.known_components.get("skills", ())
                ),
            }
        with context.repo.write_lock():
            change = plugins.import_plugin_snapshot(
                context.repo,
                snapshot,
                category=args.category,
                targets=targets,
                tags=args.tag,
                replace=args.replace,
            )
            change.details["marketplace"] = marketplace.build(context.repo)
        return context.finish(change)


