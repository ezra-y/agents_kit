def command_status(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    repo = context.repo
    inventory = repo.skill_registry()
    by_category: dict[str, int] = {}
    for entry in inventory.values():
        by_category[entry.category] = by_category.get(entry.category, 0) + 1
    return {
        "root": str(repo.root),
        "skills": len(inventory),
        "plugins": len(repo.plugin_inventory()),
        "active": len(repo.read_active()),
        "independent_enabled": len(repo.read_active()),
        "configured_available": len(repo.skill_activation()),
        "availability_note": "包含随插件启用的技能；实际加载以 check --runtime 为准",
        "sync": automation.read_status(repo),
        "desired_installations": sum(
            len(record.get("skills", [])) + len(record.get("plugins", []))
            for record in repo.read_desired_installations()["targets"].values()
        ),
        "sources": len(repo.read_sources()["skills"])
        + len(repo.read_sources()["plugins"]),
        "metadata": len(repo.read_metadata()["skills"]),
        "mcps": len(repo.read_mcps()["servers"]),
        "enabled_mcps": sum(
            1 for record in repo.read_mcps()["servers"].values() if record["enabled"]
        ),
        "scout_sources": len(repo.read_scout()["sources"]),
        "scout_skills": sum(
            len(record.get("skills", []))
            for record in repo.read_scout()["sources"].values()
        ),
        "categories": dict(sorted(by_category.items())),
    }


def command_sync(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    result = automation.sync(context.repo)
    if result.get("status") == "failed":
        raise CommandError(result.get("message", "同步失败"), result)
    return result


def command_migrate(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    if args.dry_run:
        metadata = context.repo.read_metadata()
        sources = context.repo.read_sources()
        return {
            "dry_run": True,
            "metadata_schema": metadata["schema_version"],
            "sources_schema": sources["schema_version"],
            "desired_exists": context.repo.desired_installations_path.is_file(),
        }
    with context.repo.write_lock():
        change = migration.migrate_legacy_state(context.repo)
    return context.finish(change)


def command_source_providers(
    args: argparse.Namespace, context: Context
) -> dict[str, Any]:
    with SourceSession(context.repo.network_timeout) as session:
        return {"providers": session.provider_names()}


def command_source_inspect(
    args: argparse.Namespace, context: Context
) -> dict[str, Any]:
    if args.refresh_index:
        if args.source:
            raise CommandError("--refresh-index 重扫全部已存来源，不接受来源参数")
        return _refresh_scout_index(context)
    if not args.source:
        raise CommandError("需要提供来源，或使用 --refresh-index")
    with SourceSession(context.repo.network_timeout) as session:
        spec = _source_spec(session, args)
        revision, candidates = session.scan(spec)
        result = {
            "provider": spec.provider,
            "locator": spec.locator,
            "revision": revision,
            "candidates": [
                {
                    "path": candidate.relative_path,
                    "name": candidate.declared_name,
                    "description": candidate.description,
                }
                for candidate in candidates
            ],
        }
        if not args.save:
            return result
        name = args.name or scout.default_name(spec)
        record = scout.build_record(spec, revision, candidates, note=args.note)
    with context.repo.write_lock():
        change = scout.save_source(context.repo, name, record)
    finished = context.finish(change)
    finished["candidates"] = result["candidates"]
    return finished


def _refresh_scout_index(context: Context) -> dict[str, Any]:
    names = sorted(context.repo.read_scout()["sources"])
    results: list[dict[str, Any]] = []
    failures: list[dict[str, str]] = []
    combined = ChangeSet()
    with SourceSession(context.repo.network_timeout) as session:
        for name in names:
            record = context.repo.read_scout()["sources"][name]
            try:
                revision, candidates = session.scan(scout.source_spec(record))
                updated = scout.build_record(
                    scout.source_spec(record),
                    revision,
                    candidates,
                    note=record.get("note", ""),
                )
                with context.repo.write_lock():
                    change = scout.save_source(context.repo, name, updated)
                results.append({"index": name, **change.details})
                combined.merge(change)
            except (OSError, RuntimeError, ValueError) as exc:
                failures.append({"index": name, "error": str(exc)})
    finished = context.finish(combined)
    finished["results"] = results
    finished["failures"] = failures
    return finished


def command_source_detach(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    entry = context.repo.require_skill(args.name)
    if entry.owner_kind == "plugin":
        plugin_id = entry.owner_id or ""
        if args.dry_run:
            return {
                "dry_run": True,
                "asset": AssetRef.plugin(plugin_id).canonical,
                "tracked": context.repo.read_sources()["plugins"].get(plugin_id)
                is not None,
            }
        with context.repo.write_lock():
            change = plugins.detach_plugin(context.repo, plugin_id)
        change.details["lifted_from"] = entry.qualified_id
        return context.finish(change)
    if args.dry_run:
        return {
            "dry_run": True,
            "skill": entry.qualified_id,
            "tracked": context.repo.source_record(entry.qualified_id) is not None,
        }
    with context.repo.write_lock():
        change = skills.detach_source(context.repo, entry.qualified_id)
    return context.finish(change)


def _source_change(
    context: Context,
    name: str,
    record: dict[str, Any],
    snapshot: Any,
) -> dict[str, Any]:
    local_path = context.repo.require_skill(name).path
    comparison = classify_source_change(
        local_path,
        snapshot,
        resolved_sha256=record.get("resolved", {}).get("content_sha256"),
    )
    if comparison.get("merge_state") != "upstream_only":
        return comparison
    validation_root = snapshot.path
    skill_text = None
    if snapshot.content_mode == ContentMode.SKILL_FILE:
        validation_root = local_path
        skill_text = (snapshot.path / "SKILL.md").read_text(
            encoding="utf-8",
            errors="replace",
        )
    problems = checks.candidate_skill_problems(
        name,
        validation_root,
        context.repo.inventory(),
        skill_text=skill_text,
    )
    if problems:
        comparison["status"] = "review_required"
        comparison["decision"] = "review_required"
        comparison["reasons"].append("candidate_validation_failed")
        comparison["validation_problems"] = problems
    return comparison


def command_source_check(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    names = _source_names(context.repo, args)
    results: list[dict[str, Any]] = []
    failures: list[dict[str, str]] = []
    with SourceSession(context.repo.network_timeout) as session:
        for name in names:
            if name.startswith("plugin:"):
                plugin_id = AssetRef.parse(name).local_id
                record = context.repo.read_sources()["plugins"].get(plugin_id)
                if record is None:
                    failures.append({"asset": name, "error": "没有来源登记"})
                    continue
                if record.get("policy") == "pinned":
                    results.append({"asset": name, "status": "pinned"})
                    continue
                try:
                    spec = SourceSpec(
                        provider=str(record["provider"]),
                        locator=dict(record["locator"]),
                    )
                    root, revision, resolved_spec = session.directory(spec)
                    snapshot = plugins.inspect_plugin_directory(
                        root,
                        revision=revision,
                        source_spec=resolved_spec,
                    )
                    comparison = plugins.classify_plugin_update(
                        context.repo, plugin_id, snapshot
                    )
                    results.append(
                        {
                            "asset": name,
                            "plugin": plugin_id,
                            **comparison,
                            "revision": revision,
                        }
                    )
                except (OSError, RuntimeError, ValueError) as exc:
                    failures.append({"asset": name, "error": str(exc)})
                continue
            record = context.repo.source_record(name)
            if record is None:
                failures.append({"skill": name, "error": "没有来源登记"})
                continue
            if record.get("policy") == "pinned":
                results.append({"skill": name, "status": "pinned"})
                continue
            try:
                snapshot = session.snapshot_from_record(record)
                comparison = _source_change(context, name, record, snapshot)
                results.append(
                    {
                        "skill": name,
                        **comparison,
                        "revision": snapshot.revision,
                    }
                )
            except (OSError, RuntimeError, ValueError) as exc:
                failures.append({"skill": name, "error": str(exc)})
    return {"results": results, "failures": failures}


def command_source_update(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    names = _source_names(context.repo, args)
    auto_docs = args.safe or args.auto_docs
    action = "无冲突的纯文档变化" if auto_docs else "当前来源内容"
    _confirm(args, f"应用 {len(names)} 个技能中{action}？")
    snapshots: list[tuple[str, str, Any]] = []
    results: list[dict[str, Any]] = []
    failures: list[dict[str, str]] = []
    with SourceSession(context.repo.network_timeout) as session:
        for name in names:
            if name.startswith("plugin:"):
                plugin_id = AssetRef.parse(name).local_id
                record = context.repo.read_sources()["plugins"].get(plugin_id)
                if record is None:
                    failures.append({"asset": name, "error": "没有来源登记"})
                    continue
                if record.get("policy") == "pinned":
                    results.append(
                        {"asset": name, "status": "pinned", "applied": False}
                    )
                    continue
                try:
                    spec = SourceSpec(
                        provider=str(record["provider"]),
                        locator=dict(record["locator"]),
                    )
                    root, revision, resolved_spec = session.directory(spec)
                    snapshot = plugins.inspect_plugin_directory(
                        root,
                        revision=revision,
                        source_spec=resolved_spec,
                    )
                    comparison = plugins.classify_plugin_update(
                        context.repo, plugin_id, snapshot
                    )
                    should_apply = (
                        comparison.get("decision") == "auto_apply"
                        if auto_docs
                        else comparison.get("merge_state") == "upstream_only"
                        and comparison.get("decision") != "blocked"
                    )
                    results.append(
                        {
                            "asset": name,
                            "plugin": plugin_id,
                            **comparison,
                            "revision": revision,
                            "applied": should_apply and not args.dry_run,
                        }
                    )
                    if should_apply:
                        snapshots.append(("plugin", plugin_id, snapshot))
                except (OSError, RuntimeError, ValueError) as exc:
                    failures.append({"asset": name, "error": str(exc)})
                continue
            record = context.repo.source_record(name)
            if record is None:
                failures.append({"skill": name, "error": "没有来源登记"})
                continue
            if record.get("policy") == "pinned":
                results.append({"skill": name, "status": "pinned", "applied": False})
                continue
            try:
                snapshot = session.snapshot_from_record(record)
                comparison = _source_change(context, name, record, snapshot)
                should_apply = (
                    comparison.get("decision") == "auto_apply"
                    if auto_docs
                    else comparison.get("merge_state") == "upstream_only"
                )
                results.append(
                    {
                        "skill": name,
                        **comparison,
                        "revision": snapshot.revision,
                        "applied": should_apply and not args.dry_run,
                    }
                )
                if should_apply:
                    snapshots.append(("skill", name, snapshot))
            except (OSError, RuntimeError, ValueError) as exc:
                failures.append({"skill": name, "error": str(exc)})
        if args.dry_run:
            return {
                "dry_run": True,
                "results": results,
                "failures": failures,
            }
        combined = ChangeSet()
        with context.repo.write_lock():
            for kind, name, snapshot in snapshots:
                if kind == "plugin":
                    combined.merge(
                        plugins.update_plugin_from_snapshot(
                            context.repo, name, snapshot
                        )
                    )
                else:
                    combined.merge(
                        skills.update_from_source(context.repo, name, snapshot)
                    )
            if "plugins" in combined.changed:
                marketplace.build(context.repo)
        result = context.finish(combined, apply_clients=not args.repo_only)
        result["results"] = results
        result["failures"] = failures
        return result


def command_source_report(
    args: argparse.Namespace,
    context: Context,
) -> dict[str, Any]:
    report = json.loads(args.report.read_text(encoding="utf-8"))
    if not isinstance(report, dict):
        raise CommandError("来源检查报告顶层必须是对象")
    source_catalog = context.repo.read_sources()
    source_records = dict(source_catalog["skills"])
    source_records.update(
        {
            AssetRef.plugin(plugin_id).canonical: record
            for plugin_id, record in source_catalog["plugins"].items()
        }
    )
    markdown = source_reports.render_source_review_markdown(
        report,
        source_records,
        run_url=args.run_url,
    )
    print(markdown, end="")
    return {"rendered": str(args.report)}


def command_skill_import(args: argparse.Namespace, context: Context) -> dict[str, Any]:
    if args.category not in context.repo.categories:
        raise CommandError(
            f"未知分类：{args.category}；可用分类："
            + ", ".join(context.repo.categories)
        )
    if args.scope == "project" and args.project is None:
        raise CommandError("--scope project 必须提供 --project")
    if args.scope == "project" and not args.project.expanduser().is_dir():
        raise CommandError(f"项目目录不存在：{args.project.expanduser()}")
    if args.replace:
        _confirm(args, "替换已有同名技能内容？")
    with SourceSession(context.repo.network_timeout) as session:
        spec = _source_spec(session, args)
        snapshot = session.snapshot(spec, candidate_path=args.candidate)
        local_name = args.name or snapshot.declared_name
        if args.dry_run:
            return {
                "dry_run": True,
                "skill": local_name,
                "category": args.category,
                "scope": args.scope,
                "provider": spec.provider,
                "locator": snapshot.spec.locator,
                "content_sha256": snapshot.content_sha256,
                "tags": args.tag,
                "existing": (
                    AssetRef.standalone_skill(local_name).canonical
                    in context.repo.skill_registry()
                ),
            }
        with context.repo.write_lock():
            change = skills.import_snapshot(
                context.repo,
                snapshot,
                category=args.category,
                name=args.name,
                description=args.description,
                trigger=args.trigger,
                recommendation=args.recommendation,
                tags=args.tag,
                policy=context.repo.config["defaults"]["source_policy"],
                replace=args.replace,
            )
            if args.scope == "global":
                change.merge(installation.enable_global(context.repo, local_name))
        if args.scope == "project":
            project_result = installation.install_project(
                context.repo,
                local_name,
                project=args.project,
                replace=args.replace,
            )
            change.details["project_install"] = project_result.details
        return context.finish(change)


