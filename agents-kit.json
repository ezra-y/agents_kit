{
  "schema_version": 2,
  "categories": {
    "video": {
      "label": "视频制作",
      "description": "直接生成、拍摄、剪辑、包装或交付视频；视频研究按最终产出进入运营或研究。"
    },
    "ios": {
      "label": "iOS",
      "description": "所有 iOS 专用能力，包括客户端、服务端、UI、设计、测试和平台工程。"
    },
    "operations": {
      "label": "运营与内容",
      "description": "宣传、增长、品牌、运营文案、内容及营销素材。"
    },
    "frontend-uiux": {
      "label": "前端与 UI/UX",
      "description": "非 iOS 的前端代码、界面、交互、视觉设计和设计系统。"
    },
    "backend": {
      "label": "后端",
      "description": "非 iOS 专用的服务端、API、认证、数据和安全能力。"
    },
    "engineering": {
      "label": "通用工程",
      "description": "跨平台的代码审查、测试、调试、架构、工具链和代码库维护。"
    },
    "product": {
      "label": "产品",
      "description": "产品发现、需求、领域模型、PRD、原型决策、Issue 和 Triage。"
    },
    "academic": {
      "label": "学术研究",
      "description": "面向学术论文与科研证据的检索、阅读、管理、分析、写作、评审和发表工作流。"
    },
    "research-office": {
      "label": "研究与办公",
      "description": "通用信息检索、业务研究、分析及文档、表格、会议、消息和办公工作流。"
    },
    "ai-building": {
      "label": "AI Building",
      "description": "AI 应用、Agent、Skill、MCP、Hook 和 AI 工作流的构建与管理。"
    }
  },
  "install_targets": {
    "global": [
      {
        "id": "claude",
        "path": "~/.claude/skills",
        "mode": "symlink"
      },
      {
        "id": "agents",
        "path": "~/.agents/skills",
        "mode": "symlink"
      }
    ],
    "project": [
      {
        "id": "claude",
        "path": ".claude/skills",
        "mode": "copy"
      }
    ]
  },
  "mcp_install_targets": {
    "global": [
      {
        "id": "codex"
      },
      {
        "id": "claude"
      }
    ]
  },
  "defaults": {
    "source_policy": "review",
    "network_timeout_seconds": 20
  },
