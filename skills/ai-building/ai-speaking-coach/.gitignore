.DS_Store
.env
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Old local prototype data is never part of the reusable Skill.
/knowledge/
/runtime/

# Durable learner data. Keep only examples and directory markers public.
private/learner/course.md
private/learner/knowledge/items.jsonl
private/learner/knowledge/sources/*
!private/learner/knowledge/sources/.gitkeep
private/learner/state/*
!private/learner/state/.gitkeep
private/learner/records/lessons/*
!private/learner/records/lessons/.gitkeep
private/learner/records/sessions/*
!private/learner/records/sessions/.gitkeep
private/learner/settings.json
private/learner/backups/*
!private/learner/backups/.gitkeep

# Transient runtime state.
private/runtime/coach-mode.sqlite
private/runtime/coach-mode.sqlite-*
private/runtime/preparation/*
!private/runtime/preparation/.gitkeep

# Rebuildable cache.
private/cache/models/*
!private/cache/models/.gitkeep
private/cache/lancedb/*
!private/cache/lancedb/.gitkeep
private/cache/diagnostics/*
!private/cache/diagnostics/.gitkeep
private/cache/embedding-manifest.json
