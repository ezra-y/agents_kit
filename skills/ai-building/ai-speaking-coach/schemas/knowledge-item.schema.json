{
  "$defs": {
    "SourceRef": {
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "order": {
          "exclusiveMinimum": 0,
          "title": "Order",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "order"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "properties": {
    "approved": {
      "default": true,
      "title": "Approved",
      "type": "boolean"
    },
    "context": {
      "default": "",
      "title": "Context",
      "type": "string"
    },
    "examples": {
      "items": {
        "type": "string"
      },
      "title": "Examples",
      "type": "array"
    },
    "group_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Group Id"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "meaning": {
      "default": "",
      "title": "Meaning",
      "type": "string"
    },
    "media_ref": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Ref"
    },
    "source_ref": {
      "$ref": "#/$defs/SourceRef"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "topics": {
      "items": {
        "type": "string"
      },
      "title": "Topics",
      "type": "array"
    },
    "type": {
      "enum": [
        "expression",
        "pattern",
        "screen_line"
      ],
      "title": "Type",
      "type": "string"
    },
    "usage_note": {
      "default": "",
      "title": "Usage Note",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "text",
    "source_ref"
  ],
  "title": "ContentItem",
  "type": "object"
}
