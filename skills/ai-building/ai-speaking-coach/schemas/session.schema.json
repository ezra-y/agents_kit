{
  "$defs": {
    "ErrorObservation": {
      "properties": {
        "error_type": {
          "enum": [
            "chinglish",
            "awkward",
            "grammar",
            "collocation",
            "pronunciation",
            "prosody",
            "pragmatics"
          ],
          "title": "Error Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "natural_version": {
          "title": "Natural Version",
          "type": "string"
        },
        "next_due_at": {
          "title": "Next Due At",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "occurred_at": {
          "title": "Occurred At",
          "type": "string"
        },
        "user_said": {
          "title": "User Said",
          "type": "string"
        }
      },
      "required": [
        "id",
        "occurred_at",
        "user_said",
        "natural_version",
        "error_type",
        "next_due_at"
      ],
      "title": "ErrorObservation",
      "type": "object"
    },
    "SessionItemResult": {
      "properties": {
        "activity": {
          "enum": [
            "new",
            "review"
          ],
          "title": "Activity",
          "type": "string"
        },
        "correction_count": {
          "default": 0,
          "minimum": 0,
          "title": "Correction Count",
          "type": "integer"
        },
        "grade": {
          "enum": [
            "forgot",
            "hard",
            "good",
            "easy"
          ],
          "title": "Grade",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "status_after": {
          "enum": [
            "learning",
            "usable",
            "fluent"
          ],
          "title": "Status After",
          "type": "string"
        },
        "studied_at": {
          "title": "Studied At",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "activity",
        "grade",
        "status_after",
        "studied_at"
      ],
      "title": "SessionItemResult",
      "type": "object"
    }
  },
  "properties": {
    "ended_at": {
      "title": "Ended At",
      "type": "string"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ErrorObservation"
      },
      "title": "Errors",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SessionItemResult"
      },
      "title": "Items",
      "type": "array"
    },
    "lesson_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lesson Path"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "summary_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary Path"
    },
    "topic": {
      "title": "Topic",
      "type": "string"
    }
  },
  "required": [
    "id",
    "started_at",
    "ended_at",
    "topic",
    "items"
  ],
  "title": "SessionRecord",
  "type": "object"
}
